#!/usr/bin/env python3
"""Share an aspect-locked region of a window or screen.

Captures a source through the xdg-desktop-portal ScreenCast API, crops it in
GStreamer, and presents the result as a plain Wayland window. Share that window
once in Discord; the crop can then be re-dragged live without restarting the
stream.
"""

import argparse
import json
import os
import socket
import subprocess
import sys
import threading
import time

import gi

gi.require_version("Gst", "1.0")
from gi.repository import Gio, GLib, Gst  # noqa: E402

APP_ID = "cropcast"
SOCKET_PATH = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "cropcast.sock"
)
STATE_DIR = os.path.join(GLib.get_user_state_dir(), "cropcast")

RATIOS = {
    "16:9": (16, 9),
    "21:9": (21, 9),
    "16:10": (16, 10),
    "free": None,
}

SOURCE_MONITOR = 1
SOURCE_WINDOW = 2


def token_path(source_types):
    """Restore tokens are per source type -- a window grant cannot restore a
    monitor request, so keeping one file per kind avoids clobbering."""
    kind = {SOURCE_MONITOR: "screen", SOURCE_WINDOW: "window"}.get(
        source_types, "any"
    )
    return os.path.join(STATE_DIR, f"restore-token-{kind}")


def parse_ratio(name):
    if name in RATIOS:
        return RATIOS[name]
    if ":" in name:
        w, h = name.split(":", 1)
        return int(w), int(h)
    raise ValueError(f"unknown ratio {name!r}")


def centered_box(sw, sh, ratio):
    """Largest box of the given ratio that fits in sw x sh, centered."""
    if ratio is None:
        return 0, 0, sw, sh
    a, b = ratio
    w = min(sw, sh * a // b)
    h = min(sh, w * b // a)
    w = h * a // b
    return (sw - w) // 2, (sh - h) // 2, w, h


class Portal:
    """Minimal synchronous client for org.freedesktop.portal.ScreenCast."""

    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.sender = self.bus.get_unique_name()[1:].replace(".", "_")
        self.proxy = Gio.DBusProxy.new_sync(
            self.bus,
            Gio.DBusProxyFlags.NONE,
            None,
            "org.freedesktop.portal.Desktop",
            "/org/freedesktop/portal/desktop",
            "org.freedesktop.portal.ScreenCast",
            None,
        )
        self.counter = 0

    def _token(self):
        self.counter += 1
        return f"cropcast_{os.getpid()}_{self.counter}"

    def request(self, method, args, options):
        token = self._token()
        options["handle_token"] = GLib.Variant("s", token)
        path = f"/org/freedesktop/portal/desktop/request/{self.sender}/{token}"

        loop = GLib.MainLoop()
        outcome = {}

        def on_response(_c, _s, _o, _i, _sig, params):
            outcome["code"], outcome["results"] = params.unpack()
            loop.quit()

        sub = self.bus.signal_subscribe(
            "org.freedesktop.portal.Desktop",
            "org.freedesktop.portal.Request",
            "Response",
            path,
            None,
            Gio.DBusSignalFlags.NONE,
            on_response,
        )
        try:
            self.proxy.call_sync(
                method,
                GLib.Variant(f"({args[0]}a{{sv}})", (*args[1], options))
                if args[1]
                else GLib.Variant("(a{sv})", (options,)),
                Gio.DBusCallFlags.NONE,
                -1,
                None,
            )
            loop.run()
        finally:
            self.bus.signal_unsubscribe(sub)

        if outcome.get("code") != 0:
            raise RuntimeError(f"{method} cancelled or failed")
        return outcome["results"]

    def open_stream(self, source_types, cursor_mode, restore_token):
        results = self.request(
            "CreateSession",
            ("", ()),
            {"session_handle_token": GLib.Variant("s", self._token())},
        )
        session = results["session_handle"]

        options = {
            "types": GLib.Variant("u", source_types),
            "multiple": GLib.Variant("b", False),
            "cursor_mode": GLib.Variant("u", cursor_mode),
            "persist_mode": GLib.Variant("u", 2),
        }
        if restore_token:
            options["restore_token"] = GLib.Variant("s", restore_token)
        self.request("SelectSources", ("o", (session,)), options)

        results = self.request("Start", ("os", (session, "")), {})
        if not results.get("streams"):
            raise RuntimeError("portal returned no streams")

        node_id = results["streams"][0][0]
        token = results.get("restore_token")

        ret, fds = self.proxy.call_with_unix_fd_list_sync(
            "OpenPipeWireRemote",
            GLib.Variant("(oa{sv})", (session, {})),
            Gio.DBusCallFlags.NONE,
            -1,
            None,
            None,
        )
        fd = fds.get(ret.unpack()[0])
        return node_id, fd, token


class CropCast:
    def __init__(self, ratio, node_id, fd, fps=60):
        self.ratio = ratio
        self.source = None
        self.region = None
        self.target = None

        # always-copy releases each PipeWire buffer straight back to xdph, and the
        # leaky queue drops frames rather than accumulating them. Without both,
        # the software crop path holds xdph's buffers until it hits "Out of
        # buffers" and the screencopy callback wedges.
        self.pipeline = Gst.parse_launch(
            f"pipewiresrc fd={fd} path={node_id} do-timestamp=true"
            " always-copy=true min-buffers=8 max-buffers=32"
            " ! queue leaky=downstream max-size-buffers=3 max-size-time=0"
            " max-size-bytes=0"
            f" ! videorate drop-only=true ! video/x-raw,framerate={fps}/1"
            " ! videoconvert"
            " ! videocrop name=crop"
            " ! videoconvert"
            " ! waylandsink name=sink sync=false"
        )
        self.crop = self.pipeline.get_by_name("crop")
        self.crop.get_static_pad("sink").add_probe(
            Gst.PadProbeType.EVENT_DOWNSTREAM, self._on_event
        )

        self.frames = 0
        self.pipeline.get_by_name("sink").get_static_pad("sink").add_probe(
            Gst.PadProbeType.BUFFER, self._count
        )

    def _count(self, _pad, _info):
        self.frames += 1
        return Gst.PadProbeReturn.OK

    def _on_event(self, _pad, info):
        event = info.get_event()
        if event.type == Gst.EventType.CAPS:
            s = event.parse_caps().get_structure(0)
            size = (s.get_value("width"), s.get_value("height"))
            if size != self.source:
                self.source = size
                GLib.idle_add(self._on_source_size)
        return Gst.PadProbeReturn.OK

    def track(self, address, follow):
        """Crop to a specific window, optionally re-cropping as it moves."""
        self.target = address
        self.apply_target()
        if follow:
            GLib.timeout_add(400, self._follow_tick)

    def _follow_tick(self):
        if not self.target:
            return False
        self.apply_target()
        return True

    def apply_target(self):
        monitor = monitor_for_source(self.source) if self.source else None
        geo = window_geometry(self.target) if self.target else None
        if not monitor or not geo:
            return False
        scale = monitor.get("scale", 1) or 1
        x, y, w, h = geo
        self.set_region(
            *ratio_box_containing(
                round((x - monitor["x"]) * scale),
                round((y - monitor["y"]) * scale),
                round(w * scale),
                round(h * scale),
                self.ratio,
                *self.source,
            )
        )
        return True

    def _on_source_size(self):
        if self.target and self.apply_target():
            return False
        sw, sh = self.source
        if self.region is None:
            self.set_region(*centered_box(sw, sh, self.ratio))
        else:
            self.set_region(*self.region)
        return False

    def set_region(self, x, y, w, h):
        if not self.source:
            return
        sw, sh = self.source
        x = max(0, min(x, sw - 1))
        y = max(0, min(y, sh - 1))
        w = max(16, min(w, sw - x))
        h = max(16, min(h, sh - y))
        self.region = (x, y, w, h)
        self.crop.set_property("left", x)
        self.crop.set_property("top", y)
        self.crop.set_property("right", sw - x - w)
        self.crop.set_property("bottom", sh - y - h)

    def start(self):
        self.pipeline.set_state(Gst.State.PLAYING)

    def stop(self):
        self.pipeline.set_state(Gst.State.NULL)


def preview_geometry():
    """Position and size of our own output window, from Hyprland."""
    out = subprocess.run(
        ["hyprctl", "clients", "-j"], capture_output=True, text=True, check=True
    )
    for client in json.loads(out.stdout):
        if client.get("class") == APP_ID or client.get("initialClass") == APP_ID:
            (x, y), (w, h) = client["at"], client["size"]
            return x, y, w, h
    return None


def ratio_box_containing(x, y, w, h, ratio, sw, sh):
    """Smallest box of the given ratio that contains x,y,w,h, clamped to sw x sh."""
    if ratio is None:
        return x, y, w, h
    a, b = ratio
    if w * b < h * a:
        w = round(h * a / b)
    else:
        h = round(w * b / a)
    w, h = min(w, sw), min(h, sh)
    cx, cy = x + w // 2, y + h // 2
    return max(0, min(cx - w // 2, sw - w)), max(0, min(cy - h // 2, sh - h)), w, h


def active_window():
    """Address and monitor-relative geometry of the focused window."""
    out = subprocess.run(
        ["hyprctl", "activewindow", "-j"], capture_output=True, text=True
    )
    if out.returncode != 0 or not out.stdout.strip():
        return None
    c = json.loads(out.stdout)
    if not c.get("address") or c.get("class") == APP_ID:
        return None
    return c["address"], (*c["at"], *c["size"])


def window_geometry(address):
    out = subprocess.run(
        ["hyprctl", "clients", "-j"], capture_output=True, text=True, check=True
    )
    for c in json.loads(out.stdout):
        if c["address"] == address:
            return (*c["at"], *c["size"])
    return None


def preview_workspace():
    out = subprocess.run(
        ["hyprctl", "clients", "-j"], capture_output=True, text=True, check=True
    )
    for c in json.loads(out.stdout):
        if c.get("class") == APP_ID or c.get("initialClass") == APP_ID:
            return c["workspace"]["id"]
    return None


def monitor_for_source(source):
    """The monitor whose pixel size matches the capture, if any."""
    out = subprocess.run(
        ["hyprctl", "monitors", "-j"], capture_output=True, text=True, check=True
    )
    for m in json.loads(out.stdout):
        if (m["width"], m["height"]) == tuple(source):
            return m
    return None


def active_workspace():
    out = subprocess.run(
        ["hyprctl", "activeworkspace", "-j"], capture_output=True, text=True
    )
    return json.loads(out.stdout)["id"]


def video_rect(win, source):
    """Where the video actually sits inside the window, accounting for letterboxing."""
    wx, wy, ww, wh = win
    sw, sh = source
    scale = min(ww / sw, wh / sh)
    vw, vh = sw * scale, sh * scale
    return wx + (ww - vw) / 2, wy + (wh - vh) / 2, vw, vh, scale


def run_slurp(ratio):
    cmd = ["slurp", "-d"]
    if ratio:
        cmd += ["-a", f"{ratio[0]}:{ratio[1]}"]
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0 or not result.stdout.strip():
        return None
    pos, size = result.stdout.strip().split(" ")
    x, y = (int(v) for v in pos.split(","))
    w, h = (int(v) for v in size.split("x"))
    return x, y, w, h


def pick_region(cast, ratio_name):
    """Drag an aspect-locked box; returns coordinates in the source's frame.

    A whole-monitor source is dragged directly on the real screen, which maps
    across 1:1 and still works while the preview sits on a hidden workspace.
    Any other source is dragged on the preview instead, so the crop is released
    first -- a box drawn on an already-cropped preview could only ever select a
    subset of the current region.
    """
    ratio = parse_ratio(ratio_name)
    if not cast.source:
        return None

    monitor = monitor_for_source(cast.source)
    if monitor:
        picked = run_slurp(ratio)
        if not picked:
            return None
        x, y, w, h = picked
        scale = monitor.get("scale", 1) or 1
        return (
            round((x - monitor["x"]) * scale),
            round((y - monitor["y"]) * scale),
            round(w * scale),
            round(h * scale),
        )

    previous = cast.region
    sw, sh = cast.source
    GLib.idle_add(cast.set_region, 0, 0, sw, sh)
    time.sleep(0.25)

    def restore():
        if previous:
            GLib.idle_add(cast.set_region, *previous)

    win = preview_geometry()
    picked = run_slurp(ratio) if win else None
    if not picked:
        restore()
        return None

    sx, sy, sel_w, sel_h = picked
    vx, vy, _, _, scale = video_rect(win, cast.source)
    return (
        round((sx - vx) / scale),
        round((sy - vy) / scale),
        round(sel_w / scale),
        round(sel_h / scale),
    )


class ControlServer(threading.Thread):
    daemon = True

    def __init__(self, cast, loop):
        super().__init__()
        self.cast, self.loop = cast, loop

    def run(self):
        if os.path.exists(SOCKET_PATH):
            os.unlink(SOCKET_PATH)
        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        server.bind(SOCKET_PATH)
        server.listen(4)
        while True:
            conn, _ = server.accept()
            with conn:
                command = conn.recv(256).decode().strip().split()
                conn.sendall(self.handle(command).encode())

    def handle(self, command):
        if not command:
            return "empty"
        verb, rest = command[0], command[1:]

        if verb == "stop":
            GLib.idle_add(self.loop.quit)
            return "stopping"

        if verb == "status":
            return (f"source={self.cast.source} region={self.cast.region} "
                    f"frames={self.cast.frames}")

        if verb in ("adjust", "ratio"):
            if not self.cast.source:
                return "no frames from the source yet"
            name = rest[0] if rest else "16:9"
            if verb == "ratio":
                self.cast.ratio = parse_ratio(name)
                sw, sh = self.cast.source
                GLib.idle_add(
                    self.cast.set_region, *centered_box(sw, sh, self.cast.ratio)
                )
                return f"ratio {name}"
            if not monitor_for_source(self.cast.source):
                ws = preview_workspace()
                if ws is not None and ws != active_workspace():
                    return (
                        f"the preview is parked on workspace {ws}; switch to it "
                        "to adjust a window source"
                    )
            region = pick_region(self.cast, name)
            if not region:
                return "cancelled"
            GLib.idle_add(self.cast.set_region, *region)
            return f"region {region}"

        return f"unknown command {verb}"


def send(command):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.connect(SOCKET_PATH)
            client.sendall(" ".join(command).encode())
            print(client.recv(4096).decode())
    except (FileNotFoundError, ConnectionRefusedError):
        sys.exit("cropcast is not running")


def run_daemon(args):
    target = active_window() if args.active_window else None
    if args.active_window and not target:
        sys.exit("no focused window to crop to")

    # Cropping to a window's rectangle needs monitor-relative coordinates, so
    # window mode captures the screen and crops rather than capturing the toplevel.
    types = SOURCE_MONITOR if args.active_window else SOURCE_WINDOW | SOURCE_MONITOR
    if args.source == "window":
        types = SOURCE_WINDOW
    elif args.source == "screen":
        types = SOURCE_MONITOR

    path = token_path(types)
    restore = None
    if args.restore and os.path.exists(path):
        restore = open(path).read().strip()

    portal = Portal()
    node_id, fd, token = portal.open_stream(
        types, 2 if args.cursor else 1, restore
    )
    if token:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(path, "w") as f:
            f.write(token)

    cast = CropCast(parse_ratio(args.ratio), node_id, fd, args.fps)
    if target:
        cast.track(target[0], not args.no_follow)
    loop = GLib.MainLoop()

    bus = cast.pipeline.get_bus()
    bus.add_signal_watch()

    def on_message(_bus, message):
        if message.type == Gst.MessageType.ERROR:
            err, debug = message.parse_error()
            print(f"cropcast: {err}\n{debug}", file=sys.stderr)
            loop.quit()
        elif message.type == Gst.MessageType.EOS:
            loop.quit()

    bus.connect("message", on_message)

    ControlServer(cast, loop).start()
    cast.start()
    try:
        loop.run()
    except KeyboardInterrupt:
        pass
    finally:
        cast.stop()
        if os.path.exists(SOCKET_PATH):
            os.unlink(SOCKET_PATH)


def main():
    parser = argparse.ArgumentParser(prog="cropcast", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    start = sub.add_parser("start", help="pick a source and open the crop window")
    start.add_argument("-r", "--ratio", default="16:9", choices=list(RATIOS))
    start.add_argument(
        "-s", "--source", default="any", choices=["any", "window", "screen"]
    )
    start.add_argument("--cursor", action="store_true", help="include the cursor")
    start.add_argument(
        "--fps", type=int, default=60, help="capture rate cap (default 60)"
    )
    start.add_argument(
        "-w",
        "--active-window",
        action="store_true",
        help="crop to the focused window instead of picking a region",
    )
    start.add_argument(
        "--no-follow",
        action="store_true",
        help="with -w, do not re-crop when the window moves or resizes",
    )
    start.add_argument(
        "--restore", action="store_true", help="reuse the last granted source"
    )

    adjust = sub.add_parser("adjust", help="re-drag the region while streaming")
    adjust.add_argument("ratio", nargs="?", default="16:9", choices=list(RATIOS))

    ratio = sub.add_parser("ratio", help="recenter at a different aspect ratio")
    ratio.add_argument("ratio", choices=list(RATIOS))

    sub.add_parser("status", help="print the current source and region")
    sub.add_parser("stop", help="shut down")

    args = parser.parse_args()

    if args.command == "start":
        GLib.set_prgname(APP_ID)
        GLib.set_application_name(APP_ID)
        Gst.init(None)
        run_daemon(args)
    elif args.command in ("adjust", "ratio"):
        send([args.command, args.ratio])
    else:
        send([args.command])


if __name__ == "__main__":
    main()
